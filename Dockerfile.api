FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY server ./server
RUN ./node_modules/.bin/esbuild server/index.ts --bundle --packages=external --platform=node --format=esm --outfile=/app/api.mjs

FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/api.mjs ./api.mjs
USER node
# /api/health runs `SELECT 1` against PostgreSQL, so this reflects DB
# reachability too, not just the Node process staying alive.
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 3001) + '/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "api.mjs"]
